{
  "_comment": "Los comandos son plantillas: verificalos con `python3 cli.py doctor --probe`. 'strengths' (0-10) son ESTIMACIONES de último recurso: el ruteo real sale de las métricas (metrics.py). 'usage' = flags que hacen al CLI devolver JSON con modelo y tokens. 'add_dir' = acceso a la carpeta de un adjunto. 'reads_files': false = el CLI no abre archivos por ruta en modo no interactivo (agy): se descarta para imágenes/PDF/binarios adjuntos. 'external' = {\"arena\": nombre-exacto, \"aa\": slug} fuerza con qué entrada de los portales se empareja el modelo. 'antigravity' reemplaza a Gemini CLI (Google lo dio de baja el 18/06/2026).",
  "cooldown_minutes": 30,
  "models": {
    "claude": {
      "label": "Claude (CLI oficial: claude)",
      "cmd": [
        "claude",
        "-p",
        "{prompt}"
      ],
      "cmd_stdin": [
        "claude",
        "-p"
      ],
      "timeout": 300,
      "strengths": {
        "general": 8,
        "coding": 9,
        "debugging": 8,
        "writing": 9,
        "analysis": 9,
        "data": 8,
        "research": 7,
        "math": 7,
        "quick": 6,
        "long_context": 7,
        "multimodal": 7
      },
      "usage": {
        "parser": "claude",
        "args": [
          "--output-format",
          "json"
        ],
        "at": 1
      },
      "add_dir": {
        "args": [
          "--add-dir",
          "{dir}"
        ],
        "at": 1
      }
    },
    "codex": {
      "label": "OpenAI Codex (CLI oficial: codex exec)",
      "cmd": [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "{prompt}"
      ],
      "cmd_stdin": [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "-"
      ],
      "timeout": 600,
      "strengths": {
        "general": 7,
        "coding": 9,
        "debugging": 9,
        "writing": 6,
        "analysis": 7,
        "data": 7,
        "research": 6,
        "math": 8,
        "quick": 6,
        "long_context": 6,
        "multimodal": 5
      },
      "usage": {
        "parser": "codex",
        "args": [
          "--json"
        ],
        "at": 2
      }
    },
    "antigravity": {
      "label": "Google Antigravity (CLI oficial: agy -p)",
      "cmd": [
        "agy",
        "-p",
        "{prompt}"
      ],
      "timeout": 300,
      "strengths": {
        "general": 7,
        "coding": 7,
        "debugging": 7,
        "writing": 7,
        "analysis": 8,
        "data": 7,
        "research": 8,
        "math": 8,
        "quick": 8,
        "long_context": 10,
        "multimodal": 9
      },
      "usage": {
        "parser": "agy",
        "args": [
          "--output-format",
          "json",
          "--log-file",
          "{logfile}"
        ],
        "at": 1
      },
      "reads_files": false
    }
  },
  "auth_cooldown_minutes": 60
}
