#!/usr/bin/env python3
"""Fake MCP server (stdio) for tests: exposes `echo` and `shout` (and `FAKE_MCP_TOOLS` extra names); FAKE_MCP_MODE=die exits at startup."""
import json, os, sys

if os.environ.get("FAKE_MCP_MODE") == "die":
    sys.exit(3)
TOOLS = ["echo", "shout"] + [t for t in os.environ.get("FAKE_MCP_TOOLS", "").split(",") if t]
for line in sys.stdin:
    msg = json.loads(line)
    if "id" not in msg:
        continue
    m, p = msg["method"], msg.get("params") or {}
    if m == "initialize":
        res = {"protocolVersion": p.get("protocolVersion"), "capabilities": {"tools": {}}, "serverInfo": {"name": "fake", "version": "1"}}
    elif m == "tools/list":
        res = {"tools": [{"name": t, "description": f"{t} tool", "inputSchema": {"type": "object", "properties": {"text": {"type": "string"}}}} for t in TOOLS]}
    elif m == "tools/call":
        text = (p.get("arguments") or {}).get("text", "")
        res = {"content": [{"type": "text", "text": (text.upper() if p["name"] == "shout" else text) + "|token=" + os.environ.get("FAKE_TOKEN", "")}]}
    else:
        print(json.dumps({"jsonrpc": "2.0", "id": msg["id"], "error": {"code": -32601, "message": "nope"}}), flush=True)
        continue
    print(json.dumps({"jsonrpc": "2.0", "id": msg["id"], "result": res}), flush=True)
