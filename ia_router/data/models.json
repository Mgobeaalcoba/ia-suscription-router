{
  "_comment": "The commands are templates: verify them with `python3 cli.py doctor --probe`. 'strengths' (0-10) are last-resort ESTIMATES: the real routing comes from the metrics (metrics.py). 'usage' = flags that make the CLI return JSON with the model and tokens. 'add_dir' = access to an attachment's folder. 'reads_files': false = the CLI does not open files by path in non-interactive mode (agy): it is discarded for attached images/PDFs/binaries. 'external' = {\"arena\": exact-name, \"aa\": slug} forces which portal entry the model is matched with. 'antigravity' replaces Gemini CLI (Google discontinued it on 2026-06-18).",
  "cooldown_minutes": 30,
  "models": {
    "claude": {
      "label": "Claude (official CLI: claude)",
      "cmd": [
        "claude",
        "-p",
        "{prompt}"
      ],
      "cmd_stdin": [
        "claude",
        "-p"
      ],
      "timeout": 300,
      "strengths": {
        "general": 8,
        "coding": 9,
        "debugging": 8,
        "writing": 9,
        "analysis": 9,
        "data": 8,
        "research": 7,
        "math": 7,
        "quick": 6,
        "long_context": 7,
        "multimodal": 7
      },
      "usage": {
        "parser": "claude",
        "args": [
          "--output-format",
          "json"
        ],
        "at": 1
      },
      "add_dir": {
        "args": [
          "--add-dir",
          "{dir}"
        ],
        "at": 1
      }
    },
    "codex": {
      "label": "OpenAI Codex (official CLI: codex exec)",
      "cmd": [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "{prompt}"
      ],
      "cmd_stdin": [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "-"
      ],
      "timeout": 600,
      "strengths": {
        "general": 7,
        "coding": 9,
        "debugging": 9,
        "writing": 6,
        "analysis": 7,
        "data": 7,
        "research": 6,
        "math": 8,
        "quick": 6,
        "long_context": 6,
        "multimodal": 5
      },
      "usage": {
        "parser": "codex",
        "args": [
          "--json"
        ],
        "at": 2
      }
    },
    "antigravity": {
      "label": "Google Antigravity (official CLI: agy -p)",
      "cmd": [
        "agy",
        "-p",
        "{prompt}"
      ],
      "timeout": 300,
      "strengths": {
        "general": 7,
        "coding": 7,
        "debugging": 7,
        "writing": 7,
        "analysis": 8,
        "data": 7,
        "research": 8,
        "math": 8,
        "quick": 8,
        "long_context": 10,
        "multimodal": 9
      },
      "usage": {
        "parser": "agy",
        "args": [
          "--output-format",
          "json",
          "--log-file",
          "{logfile}"
        ],
        "at": 1
      },
      "reads_files": false
    }
  },
  "auth_cooldown_minutes": 60
}
